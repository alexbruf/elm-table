{
    "type": "package",
    "name": "alexbruf/elm-table",
    "summary": "Headless table state and row-model pipeline, a port of TanStack Table core",
    "license": "MIT",
    "version": "1.0.0",
    "exposed-modules": [
        "Table",
        "Table.Value",
        "Table.SortFn",
        "Table.FilterFn",
        "Table.AggregationFn"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/time": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
